{
  "name": "beetle-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "icons": "node scripts/generate-icons.mjs",
    "state": "node scripts/sync-state.mjs",
    "sync": "npm run icons && npm run state",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform web --output-dir dist",
    "screens": "node test/screens.mjs dist",
    "reach": "node test/reach.mjs",
    "copy": "node test/copy.mjs dist",
    "flows": "node test/flows.mjs dist",
    "verify": "npm run bundle && npm run screens && npm run copy && npm run geometry && npm run flows",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run reach && npm run verify",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/*.mjs\"",
    "geometry": "node test/geometry.mjs dist",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/*.mjs\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "^57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^10.0.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  }
}
