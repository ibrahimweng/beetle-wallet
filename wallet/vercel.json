{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci --no-audit --no-fund",
  "buildCommand": "npm run site",
  "outputDirectory": "site/out",
  "rewrites": [
    { "source": "/expo", "has": [{ "type": "header", "key": "expo-platform", "value": "ios" }], "destination": "/expo/ios.json" },
    { "source": "/expo", "has": [{ "type": "header", "key": "expo-platform", "value": "android" }], "destination": "/expo/android.json" }
  ],
  "headers": [
    {
      "source": "/expo",
      "headers": [
        { "key": "expo-protocol-version", "value": "1" },
        { "key": "expo-sfv-version", "value": "0" },
        { "key": "cache-control", "value": "private, max-age=0" }
      ]
    },
    {
      "source": "/expo/(ios|android).json",
      "headers": [
        { "key": "expo-protocol-version", "value": "1" },
        { "key": "expo-sfv-version", "value": "0" },
        { "key": "cache-control", "value": "private, max-age=0" }
      ]
    },
    {
      "source": "/expo/(js|assets)/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(js|assets)/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "cache-control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(index|app).html",
      "headers": [{ "key": "cache-control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
