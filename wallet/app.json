{
  "expo": {
    "name": "Beetle",
    "slug": "wengs-test",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "beetle",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.beetle.wallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Beetle uses Face ID so that only you can open the app and move money."
      }
    },
    "android": {
      "package": "com.beetle.wallet",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Beetle uses Face ID so that only you can open the app and move money."
        }
      ],
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "owner": "ibrahimweng",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d14ce01-1e60-47d3-8e0d-76a08e93fba5"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1d14ce01-1e60-47d3-8e0d-76a08e93fba5"
    }
  }
}
